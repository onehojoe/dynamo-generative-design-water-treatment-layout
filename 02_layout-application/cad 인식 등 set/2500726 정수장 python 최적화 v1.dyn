    {
      "ConcreteType": "Dynamo.Graph.Nodes.ZeroTouch.DSFunction, DynamoCore",
      "Id": "e72ce028cc11436b9effdb07dfc4ad43",
      "NodeType": "FunctionNode",
      "Inputs": [
        {
          "Id": "7f036984c77c40a2988c6bedbdc5ddbf",
          "Name": "geometry",
          "Description": "Autodesk.DesignScript.Geometry.Geometry",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "a3a69466d27248998fdc8828224c37df",
          "Name": "other",
          "Description": "Geometry",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "0e35241364654d4e88377e7161e6d98b",
          "Name": "Geometry[]",
          "Description": "Geometry[]",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "FunctionSignature": "Autodesk.DesignScript.Geometry.Geometry.Intersect@Autodesk.DesignScript.Geometry.Geometry",
      "Replication": "Auto",
      "Description": "이 객체와 다른 객체의 교차 형상 가져오기\n\nGeometry.Intersect (other: Geometry): Geometry[]"
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import clr\r\n\r\n# Revit 및 Dynamo API 라이브러리 참조 추가\r\nclr.AddReference(\"RevitAPI\")\r\nclr.AddReference(\"ProtoGeometry\")\r\n\r\nfrom Autodesk.DesignScript.Geometry import *\r\nimport sys\r\n\r\n# 입력 데이터 가져오기\r\nsurfaces_to_place = IN[0] # 배치할 Surface 들\r\ntarget_points = IN[1]     # 배치될 위치 후보 점들\r\npre_existing_obstacles = IN[2] # 처음부터 존재하는 장애물 Surface(들)\r\n\r\n# --- 수정된 부분: 최종 배치 리스트 초기화 ---\r\n# final_placements 리스트를 IN[2]의 장애물로 초기화합니다.\r\nfinal_placements = []\r\nif pre_existing_obstacles is not None:\r\n    # 입력이 단일 객체인지 리스트인지 확인하여 모두 처리\r\n    if isinstance(pre_existing_obstacles, list):\r\n        final_placements.extend(pre_existing_obstacles)\r\n    else:\r\n        final_placements.append(pre_existing_obstacles)\r\n# ---------------------------------------------\r\n\r\n# 사용 가능한 포인트를 리스트로 관리\r\navailable_points = list(target_points)\r\n\r\n# 각 Surface를 순서대로 배치\r\nfor i, current_surface in enumerate(surfaces_to_place):\r\n    print(f\"\\n--- Processing Surface {i+1} ---\")\r\n\r\n    if not available_points:\r\n        print(\"DEBUG: No available points left.\")\r\n        break\r\n\r\n    placement_successful = False\r\n    \r\n    # 배치 가능한 포인트를 순회하며 시도 (인덱스 접근을 위해 enumerate 사용)\r\n    for p_index, p_point in enumerate(list(available_points)): # 순회 중 삭제를 위한 복사본 사용\r\n        print(f\"\\n  Trying Point {p_index+1} at {p_point.ToString()}\")\r\n        \r\n        # 후보 지오메트리 생성\r\n        bbox = current_surface.BoundingBox\r\n        original_center = Point.ByCoordinates(\r\n            (bbox.MinPoint.X + bbox.MaxPoint.X) / 2.0,\r\n            (bbox.MinPoint.Y + bbox.MaxPoint.Y) / 2.0,\r\n            (bbox.MinPoint.Z + bbox.MaxPoint.Z) / 2.0\r\n        )\r\n        translation_vector = Vector.ByTwoPoints(original_center, p_point)\r\n        candidate_s = current_surface.Translate(translation_vector)\r\n\r\n        is_overlapping = False\r\n        \r\n        # 이전에 배치된 모든 Surface(초기 장애물 포함)와 개별적으로 비교\r\n        for j, existing_surface in enumerate(final_placements):\r\n            print(f\"    Checking against existing geometry {j+1}...\")\r\n            \r\n            try:\r\n                intersect_result = existing_surface.Intersect(candidate_s)\r\n                \r\n                if not intersect_result:\r\n                    print(\"      -> Intersect Result: Is EMPTY. No overlap found.\")\r\n                    continue\r\n\r\n                if not isinstance(intersect_result, list):\r\n                    intersect_result = [intersect_result]\r\n\r\n                print(f\"      -> Intersect Result: Found {len(intersect_result)} intersection object(s).\")\r\n                \r\n                for item_index, item in enumerate(intersect_result):\r\n                    item_type_name = item.GetType().Name\r\n                    item_bbox_diag = item.BoundingBox.MaxPoint.DistanceTo(item.BoundingBox.MinPoint)\r\n                    print(f\"        - Item {item_index+1}: Type is '{item_type_name}', BBox Diagonal is {item_bbox_diag:.4f}\")\r\n                    \r\n                    if isinstance(item, (Solid, Surface, PolySurface, Mesh)):\r\n                        if item_bbox_diag > 0.001:\r\n                            print(\"        !!! REAL OVERLAP DETECTED !!!\")\r\n                            is_overlapping = True\r\n                            break\r\n            except Exception as e:\r\n                print(f\"      !!! INTERSECT CHECK FAILED with error: {e} !!!\")\r\n                is_overlapping = True\r\n            \r\n            if is_overlapping:\r\n                break\r\n        \r\n        if not is_overlapping:\r\n            print(f\"  --> SUCCESS! This position is valid.\")\r\n            final_placements.append(candidate_s)\r\n            # 원본 리스트에서 해당 인덱스의 아이템을 제거\r\n            # pop()을 사용하기 위해 순회 시 복사본을 사용해야 함\r\n            original_index_to_remove = available_points.index(p_point)\r\n            available_points.pop(original_index_to_remove)\r\n\r\n            placement_successful = True\r\n            break\r\n    \r\n    if not placement_successful:\r\n        print(f\"WARNING: Could not find any valid placement for Surface {i+1}\")\r\n\r\n# 최종 결과물 출력: IN[0]으로 들어온 것들만 골라서 출력\r\n# final_placements에는 초기 장애물이 포함되어 있으므로, 이를 제외하고 출력합니다.\r\nnum_obstacles = 0\r\nif pre_existing_obstacles is not None:\r\n    num_obstacles = len(pre_existing_obstacles) if isinstance(pre_existing_obstacles, list) else 1\r\n\r\n# 순수하게 이번 스크립트에서 배치된 결과만 슬라이싱하여 출력\r\nnewly_placed_surfaces = final_placements[num_obstacles:]\r\n\r\nOUT = newly_placed_surfaces",
      "Engine": "CPython3",
      "EngineName": "CPython3",
      "VariableInputPorts": true,
      "Id": "37c84cae246443fa91ace7e7abf5eb05",
      "NodeType": "PythonScriptNode",
      "Inputs": [
        {
          "Id": "b7e84efe23a345409ee9518d60dbbd0b",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "5e2f785868214335b3bfbc0a1b51d381",
          "Name": "IN[1]",
          "Description": "Input #1",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "d8730eac58c7462babbc8aacb0288cd2",
          "Name": "IN[2]",
          "Description": "Input #2",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "83c2ddd342b944a99055abab00afc05d",
          "Name": "OUT",
          "Description": "Python 스크립트의 결과",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "포함된 Python 스크립트를 실행합니다."
    },
    {
