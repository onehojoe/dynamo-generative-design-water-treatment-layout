    {
      "ConcreteType": "Dynamo.Graph.Nodes.ZeroTouch.DSFunction, DynamoCore",
      "Id": "daabf73145ae48dea574c903eb97650f",
      "NodeType": "FunctionNode",
      "Inputs": [
        {
          "Id": "706cf9ad7edb4b8a8322fdb50933dccc",
          "Name": "curve",
          "Description": "Autodesk.DesignScript.Geometry.Curve",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "d2ec522f92434e11bbcac8f48ce81f9c",
          "Name": "signedDistance",
          "Description": "양수 간격띄우기 거리는 곡선의 접선과 평면의 법선 벡터 사이의 외적 방향으로 적용되는 반면 음수 간격띄우기는 반대 방향으로 적용됩니다.\n\ndouble\n기본값 : 1",
          "UsingDefaultValue": true,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "1b8fefb898ae4db7a8bf5455f74c24bd",
          "Name": "planeNormal",
          "Description": "곡선의 평면 법선. 기본값은 입력 곡선의 평면 법선입니다.\n\nVector\n기본값 : null",
          "UsingDefaultValue": true,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "5ab7fc8c4a8944b28abd35f6c9a6e5fa",
          "Name": "Curve[]..[]",
          "Description": "하나 이상의 간격띄우기 곡선",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "FunctionSignature": "Autodesk.DesignScript.Geometry.Curve.OffsetMany@double,Autodesk.DesignScript.Geometry.Vector",
      "Replication": "Auto",
      "Description": "평면 법선으로 정의된 평면에서 지정된 거리만큼 평면형 곡선을 간격띄우기하여 하나 이상의 곡선을 작성합니다. 간격띄우기 구성요소 곡선 사이에 간격이 있으면 해당 간격은 간격띄우기 곡선을 확장하여 채워집니다. \"planeNormal\" 입력 인수는 기본적으로 곡선을 포함하는 평면의 법선으로 지정되지만, 원래 곡선 법선에 평행인 명시적 법선이 간격띄우기 방향을 보다 잘 제어할 수 있도록 제공될 수 있습니다. 예를 들어, 동일한 평면을 공유하는 여러 곡선에 대해 일정한 방향으로 간격띄우기를 해야 하는 경우 \"planeNormal\"을 사용하여 각각의 곡선 법선을 재지정하고 모든 곡선을 동일한 방향으로 강제로 간격띄우기할 수 있습니다. 법선을 반전하면 간격띄우기의 방향이 반대가 됩니다.\n\nCurve.OffsetMany (signedDistance: double = 1, planeNormal: Vector = null): Curve[]..[]"
    },
